{
  "name": "claso-clinic",
  "version": "0.1.0",
  "private": true,
  "description": "نظام كيورا لإدارة العيادات والإحصائيات الشاملة",
  "author": "NMR",
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron:start": "npm run build && electron .",
    "electron:dev": "electron .",
    "dist": "next build && electron-builder"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "firebase": "^12.16.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-is-dev": "^3.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
"build": {
    "appId": "com.cura.clinic",
    "productName": "Cura Clinic System",
    "copyright": "Copyright © 2026 Cura Clinic",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "main.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "نظام كيورا"
    }
  }
}